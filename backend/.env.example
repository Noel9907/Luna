ENV=development

# Two roles against the same database. The first owns the tables and runs
# migrations; the second owns nothing and is what the API actually connects as,
# so row-level security applies to it. `frame_app` is created by the migration.
#
# Keep BOTH set in development. With DATABASE_APP_URL unset the API falls back
# to the owner connection and every studio can see every other studio, which is
# a difference from production you would never notice until it mattered.
DATABASE_URL=postgresql+psycopg://frame:frame@localhost:55432/frame
DATABASE_APP_URL=postgresql+psycopg://frame_app:frame_app@localhost:55432/frame
APP_DB_PASSWORD=frame_app

# Local disk needs no cloud account. Switch to r2 once you have credentials;
# nothing else in the code changes.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
PUBLIC_BASE_URL=http://localhost:8000

# The QR code encodes this. Wrong in production means every printed QR at the
# venue points at localhost.
GUEST_BASE_URL=http://localhost:5175
# `null` is what Chromium sends as Origin from a file:// page, which is how the
# packaged desktop app loads. Without it, released builds are blocked by CORS
# while development on a dev server works fine.
CORS_ORIGINS_RAW=http://localhost:5174,http://localhost:5175,file://,null

# R2 (leave blank while STORAGE_BACKEND=local)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Cosine similarity above this counts as the same person.
# Tune this against real wedding photographs. See scripts/tune_threshold.py
MATCH_THRESHOLD=0.363

# Quality gates applied before a face is embedded at all.
# 112 is the recogniser's own input size. Below it the model is fed upscaled
# pixels, so the detail it sees is invented and the embedding drifts.
MIN_FACE_PX=112
MIN_DETECT_SCORE=0.7

# Blur floor for INDEXED faces, on the aligned 112x112 crop. Selfies have their
# own gate at 40 and are unaffected. 0.0 is off; raise it from the blur sweep
# tune_threshold.py prints, not from a guess.
INDEX_MIN_BLUR=0.0

# sface (128-dim, ships) or auraface (512-dim, needs onnxruntime plus a
# migration and a re-index). Changing this invalidates every stored embedding.
FACE_BACKEND=sface

# Signs access tokens. This value is fine locally and is refused in production,
# where it must be at least 32 random characters.
JWT_SECRET=dev-only-change-me   # python -c "import secrets;print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Face retention is negotiated per studio and capped here. Raising the ceiling
# takes an edit and a restart, which is the right amount of friction for a
# limit on how long biometric data is kept.
DEFAULT_FACE_RETENTION_DAYS=30
MAX_FACE_RETENTION_DAYS=180

# Blank means fake mode: orders are minted locally and the webhook can be fired
# at yourself with a real signature. Fake mode is refused in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Watermark burned into the lower-left of every indexed photograph. Empty = off.
# Applied at INDEX time, so turning it on only affects photographs indexed
# afterwards. The uploaded original is never modified.
WATERMARK_TEXT=
WATERMARK_OPACITY=0.75
