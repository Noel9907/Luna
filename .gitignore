# ── dependencies and build output ──────────────────────────────────────
node_modules/
dist/
dist-electron/
build/
release/
*.tsbuildinfo
.vite/

# ── secrets ────────────────────────────────────────────────────────────
# .env holds database passwords, the JWT signing secret, and Razorpay keys.
# .env.example is the template and is committed.
.env
.env.*
!.env.example
*.pem
*.key

# ── other people's faces ───────────────────────────────────────────────
# Uploaded photographs and their thumbnails. This is real biometric data from
# real guests and must never reach a public repository.
backend/storage/
storage/
testfaces/
match_review.html

# ── model weights ──────────────────────────────────────────────────────
# ~38MB of ONNX, fetched by scripts/download_models.py. Apache 2.0, but
# binaries do not belong in git.
backend/models/
*.onnx

# ── python ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

